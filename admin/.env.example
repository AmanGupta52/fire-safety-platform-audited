# REQUIRED. Base URL of the API, including the /api prefix, with no trailing slash.
#   local development: http://localhost:5000/api
#   production:        https://<your-service>.onrender.com/api
# `npm run build` stops with an error if this is missing, so a production site can never silently call localhost.
# (In `npm run dev` it falls back to http://localhost:5000/api if you leave it out.)
VITE_API_URL=http://localhost:5000/api

# Optional: error monitoring. Leave empty to disable Sentry completely.
VITE_SENTRY_DSN=
# Optional tuning (0 to 1). Defaults: traces 0.1 in production, session replay off, replay-on-error 0.5.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_REPLAYS_SESSION_RATE=0
# VITE_SENTRY_REPLAYS_ERROR_RATE=0.5
