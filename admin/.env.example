VITE_API_URL=http://localhost:5000/api

# Optional: error monitoring. Leave empty to disable Sentry completely.
VITE_SENTRY_DSN=
# Optional tuning (0 to 1). Defaults: traces 0.1 in production, session replay off, replay-on-error 0.5.
