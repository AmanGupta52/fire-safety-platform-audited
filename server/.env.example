# ---------- CORE ----------
NODE_ENV=development
PORT=5000

# ---------- DATABASE ----------
MONGODB_URI=mongodb://127.0.0.1:27017/fire-safety-platform

# ---------- AUTH ----------
JWT_SECRET=change_this_super_secret_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_other_super_secret_value
JWT_REFRESH_EXPIRES_IN=7d
# Signs the tamper-evident audit-log chain. Use a long random value that is DIFFERENT from the JWT secrets.
# Do not change it later: entries sealed with the old value would then fail verification.
AUDIT_HMAC_SECRET=change_this_audit_chain_secret

# How many reverse proxies sit in front of the API: 0 = none (direct), 1 = e.g. nginx / Render / Railway / Heroku.
# Getting this right matters: it decides which client IP is used for rate limits, lockouts and the audit log.
TRUST_PROXY=1

# ---------- CLIENT / ADMIN URLS ----------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Absolute origin the API itself is reachable at (no trailing slash). Only used to build
# full URLs for images saved to the local /uploads fallback when Cloudinary is blank below —
# set this to your real API domain in production (e.g. https://api.yourdomain.com).
PUBLIC_URL=http://localhost:5000

# ---------- CLOUDINARY (leave blank to use local /uploads in dev) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- EMAIL ----------
# EMAIL_MODE=development logs emails to console instead of sending
EMAIL_MODE=development
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@firesafety.example

# ---------- PAYMENTS ----------
# PAYMENT_MODE=mock simulates a successful/failed payment locally, never a real charge
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- SMS / WHATSAPP (provider-ready, mocked by default) ----------
SMS_MODE=mock
SMS_API_KEY=
WHATSAPP_MODE=mock
WHATSAPP_API_KEY=

# ---------- LOGGING / MONITORING ----------
# LOG_LEVEL: trace | debug | info | warn | error | silent  (default: debug in dev, info in production)
LOG_LEVEL=
# Leave SENTRY_DSN empty to turn error monitoring off.
SENTRY_DSN=

# ---------- DASHBOARD ----------
# Jobs a technician can hold at once before the dashboard shows them as fully loaded (100%).
TECHNICIAN_MAX_CONCURRENT_JOBS=4

# ---------- TESTS ----------
# Database used by `npm test`. Its name MUST contain "test": the suite deletes everything in it.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/fire-safety-test-suite

# ---------- CRON SCHEDULES ----------
REFILL_REMINDER_CRON=0 9 * * *
AMC_REMINDER_CRON=0 9 * * *
LOW_STOCK_CRON=0 8 * * *

# ---------- SEED ----------
SEED_ADMIN_EMAIL=admin@firesafety.example
SEED_ADMIN_PASSWORD=ChangeMe123!
